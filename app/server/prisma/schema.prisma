// 数据模型定义：docs/01-MVP产品设计方案.md 第 6 节
// R0 只建用户/部门域，为后续认证与业务开发做准备。

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Department {
  id          Int    @id @default(autoincrement())
  wecomDeptId String @unique @map("wecom_dept_id")
  name        String
  parentId    String? @map("parent_id")
  order       Int     @default(0)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users User[]

  @@index([parentId])
  @@map("departments")
}

model User {
  id        Int      @id @default(autoincrement())
  userid    String   @unique // 企微 userid，设计 2.2
  name      String
  avatar    String?
  role      UserRole @default(EMPLOYEE) // 设计 2.3
  skillTags String[] @default([]) @map("skill_tags") // 技术员分组，V1 用标签实现
  enabled   Boolean  @default(true) // 离职同步时置 false
  deptId    Int      @map("dept_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  department Department @relation(fields: [deptId], references: [id])

  @@index([deptId])
  @@index([role, enabled])
  @@map("users")
}

enum UserRole {
  EMPLOYEE
  TECHNICIAN
  ADMIN
}

enum TicketStatus {
  PENDING          @map("pending")          // 待处理
  IN_PROGRESS      @map("in_progress")      // 处理中
  WAITING_CONFIRM  @map("waiting_confirm")  // 待确认
  CLOSED           @map("closed")           // 已关闭
  SUSPENDED        @map("suspended")        // 挂起
  CANCELLED        @map("cancelled")        // 已取消

  @@map("ticket_status")
}

enum Urgency {
  LOW     @map("low")    // 不紧急
  MEDIUM  @map("medium") // 有点急
  HIGH    @map("high")   // 很急

  @@map("urgency")
}

enum Impact {
  ONLY_ME  @map("only_me")  // 仅我
  SEVERAL  @map("several")  // 多人
  ALL      @map("all")      // 全公司

  @@map("impact")
}

enum Priority {
  P1 @map("p1")
  P2 @map("p2")
  P3 @map("p3")
  P4 @map("p4")

  @@map("priority")
}

enum TicketEventAction {
  CREATE   @map("create")
  ASSIGN   @map("assign")
  REPLY    @map("reply")
  SUSPEND  @map("suspend")
  RESOLVE  @map("resolve")
  CLOSE    @map("close")
  CANCEL   @map("cancel")
  TRANSFER @map("transfer")
  RESUME   @map("resume")
  REJECT   @map("reject")

  @@map("ticket_event_action")
}

model Category {
  id        Int      @id @default(autoincrement())
  parentId  Int?     @map("parent_id")
  name      String
  level     Int      @default(1) // 1=大类，2=小类，设计 3.4
  icon      String?
  enabled   Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tickets    Ticket[]
  kbArticles KbArticle[]

  @@index([parentId])
  @@index([level, enabled])
  @@unique([parentId, name], name: "category_parent_name")
  @@map("categories")
}

model Ticket {
  id                Int          @id @default(autoincrement())
  ticketNo          String       @unique @map("ticket_no") // 如 INC-20260725-003
  title             String
  description       String
  attachments       String[]     @default([])
  categoryId        Int          @map("category_id")
  status            TicketStatus @default(PENDING)
  urgency           Urgency
  impact            Impact?
  priority          Priority? // 系统计算，设计 3.5
  requesterUserid   String       @map("requester_userid")
  substituteUserid  String?      @map("substitute_userid")
  agentUserid       String?      @map("agent_userid")
  responseDeadline  DateTime?    @map("response_deadline")
  resolveDeadline   DateTime?    @map("resolve_deadline")
  actualResponseAt  DateTime?    @map("actual_response_at")
  actualResolveAt   DateTime?    @map("actual_resolve_at")
  solution          String?
  rating            Int?
  ratingComment     String?      @map("rating_comment")
  relatedProblemId  Int?         @map("related_problem_id")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  category        Category         @relation(fields: [categoryId], references: [id])
  events          TicketEvent[]
  problemIncidents ProblemIncident[]

  @@index([status])
  @@index([agentUserid, status])
  @@index([requesterUserid])
  @@index([priority])
  @@map("tickets")
}

model TicketEvent {
  id          Int               @id @default(autoincrement())
  ticketId    Int               @map("ticket_id")
  actorUserid String            @map("actor_userid")
  action      TicketEventAction
  fromStatus  TicketStatus?     @map("from_status")
  toStatus    TicketStatus?     @map("to_status")
  comment     String?
  attachments String[]          @default([])
  createdAt   DateTime          @default(now()) @map("created_at")

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([createdAt])
  @@map("ticket_events")
}

enum ProblemStatus {
  INVESTIGATING   @map("investigating")   // 调查中
  ROOT_CAUSE_FOUND @map("root_cause_found") // 已定位根因
  KNOWN_ERROR     @map("known_error")     // 已知错误
  RESOLVED        @map("resolved")        // 已解决

  @@map("problem_status")
}

model Problem {
  id           Int           @id @default(autoincrement())
  title        String
  symptom      String        // 症状
  rootCause    String?       @map("root_cause") // 根本原因
  workaround   String?       // 临时方案
  finalSolution String?      @map("final_solution") // 最终解决方案
  status       ProblemStatus @default(INVESTIGATING)
  ownerUserid  String        @map("owner_userid") // 负责人
  isKnownError Boolean       @default(false) @map("is_known_error")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  incidents ProblemIncident[]

  @@index([status])
  @@index([ownerUserid])
  @@map("problems")
}

model ProblemIncident {
  id         Int      @id @default(autoincrement())
  problemId  Int      @map("problem_id")
  ticketId   Int      @map("ticket_id")
  meToo      Boolean  @default(false) @map("me_too") // “我也遇到了”标记
  createdAt  DateTime @default(now()) @map("created_at")

  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  ticket  Ticket  @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@unique([problemId, ticketId])
  @@index([problemId])
  @@index([ticketId])
  @@map("problem_incidents")
}

enum KbArticleStatus {
  DRAFT     @map("draft")
  PUBLISHED @map("published")

  @@map("kb_article_status")
}

enum KbArticleSource {
  MANUAL  @map("manual")
  TICKET  @map("ticket")
  PROBLEM @map("problem")

  @@map("kb_article_source")
}

model KbArticle {
  id         Int            @id @default(autoincrement())
  title      String
  content    String
  categoryId Int            @map("category_id")
  tags       String[]       @default([])
  sourceType KbArticleSource @default(MANUAL) @map("source_type")
  sourceId   Int?           @map("source_id") // 来源工单/问题 ID
  status     KbArticleStatus @default(DRAFT)
  likes      Int            @default(0)
  dislikes   Int            @default(0)
  views      Int            @default(0)
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")

  category Category @relation(fields: [categoryId], references: [id])

  @@index([status])
  @@index([categoryId])
  @@index([sourceType, sourceId])
  @@map("kb_articles")
}
